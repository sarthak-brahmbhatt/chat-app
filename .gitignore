# Maven (no longer used after the Gradle migration, harmless to keep in case a
# module ever reverts)
target/

# Gradle build output and local caches. NOTE: this deliberately does NOT ignore
# gradlew, gradlew.bat, or gradle/wrapper/** — those wrapper files must be committed
# so the project is buildable without Gradle pre-installed (see gradle-wrapper.properties).
build/
.gradle/

*.class
.idea/
*.iml
.DS_Store

# load-test/ (build-order step 11): the SCRIPTS are the committed, reusable
# artifact (seed-users.js, ws-ramp-test.js, capture-docker-stats.sh); their
# OUTPUT is regenerated by every run and not worth version-controlling —
# users.json holds short-lived JWTs (15-min access-token lifetime, CLAUDE.md
# 3.3) that are stale before the next person even opens the file, and the
# CSV/log are raw per-run data, not source. The actual observed RESULTS of a
# run are recorded as prose in CLAUDE.md 3.6 instead.
load-test/users.json
load-test/docker-stats.csv
load-test/k6-run.log

# Real secrets for the deployed chat-app CloudFormation stack (MysqlRootPassword,
# JwtSecret) - generated via openssl rand, never meant to sit in git history the
# way docker-compose.yml's dev-only defaults deliberately do (CLAUDE.md 3.3).
.env.aws.local
