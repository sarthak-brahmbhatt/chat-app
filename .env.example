# Copy to `.env` (same directory) and fill in a real key:
#
#     cp .env.example .env
#
# Docker Compose reads `.env` automatically from the project root and substitutes
# these into docker-compose.yml's ${...} placeholders. `.env` is gitignored; this
# template is not. Nothing here is required to start the stack — with no key set,
# chat-service still boots and the DoctorAssistant bot replies with a
# "not configured" message instead (CLAUDE.md 3.9).

# Your OpenAI API key (https://platform.openai.com/api-keys).
OPENAI_API_KEY=

# The model the bot calls. Must support the Responses API and structured outputs.
OPENAI_MODEL=gpt-4o-mini
